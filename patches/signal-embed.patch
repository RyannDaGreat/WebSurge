diff --git a/app/src/services/ParentPortOutput.ts b/app/src/services/ParentPortOutput.ts
new file mode 100644
index 00000000..63d06fa3
--- /dev/null
+++ b/app/src/services/ParentPortOutput.ts
@@ -0,0 +1,61 @@
+import { SendableEvent, SynthOutput } from "@signal-app/player"
+import { isEmbedded } from "../helpers/platform"
+
+// WebSurge: a SynthOutput that forwards MIDI to the embedding page.
+//
+// Everything that makes a sound in signal -- pressing a key in the piano
+// gutter, dragging a note, hitting play, an instrument preview -- ends up in
+// Player.sendEvent, which fans out through GroupOutput to whatever SynthOutputs
+// are enabled. MIDIOutput in this same directory is the existing example of a
+// SynthOutput that sends the events somewhere else instead of synthesizing
+// them. This is the same idea with an iframe boundary in place of a MIDI port,
+// so an embedding page can be the instrument.
+//
+// WHY delayMs AND NOT A TIMESTAMP
+// ------------------------------
+// SynthOutput.sendEvent is handed `delayTime` in seconds plus `timestampNow`,
+// a performance.now() reading, and the pair means "due delayTime after
+// timestampNow". performance.now() is measured from each browsing context's own
+// time origin, and an iframe's origin is not its parent's, so forwarding
+// timestampNow would hand the parent a number from a clock it does not share.
+// The delay is collapsed to a single relative figure here, at the moment of
+// posting, which needs no shared clock to interpret.
+export const SYNTH_OUTPUT_MESSAGE = "signal:synth-output"
+
+export interface SynthOutputMessage {
+  type: typeof SYNTH_OUTPUT_MESSAGE
+  event: SendableEvent
+  // Milliseconds from the moment this message was posted until the event is due.
+  delayMs: number
+}
+
+export class ParentPortOutput implements SynthOutput {
+  // Returns an output when embedded, or null when this page is the top frame,
+  // in which case the caller should use the built-in SoundFont synth.
+  static ifEmbedded(): ParentPortOutput | null {
+    return isEmbedded() ? new ParentPortOutput(window.parent) : null
+  }
+
+  private constructor(private readonly parent: Window) {}
+
+  activate() {
+    // Nothing to resume: the embedding page owns the audio graph, and cannot be
+    // brought out of suspension from in here anyway -- the user gesture that
+    // would allow it happened in the other frame.
+  }
+
+  sendEvent(
+    event: SendableEvent,
+    delayTime: number = 0,
+    timestampNow: number = performance.now(),
+  ): void {
+    const message: SynthOutputMessage = {
+      type: SYNTH_OUTPUT_MESSAGE,
+      event,
+      delayMs: delayTime * 1000 + (timestampNow - performance.now()),
+    }
+    // The embedder self-hosts this build, so it is same-origin and the target
+    // can be pinned rather than left as "*".
+    this.parent.postMessage(message, window.location.origin)
+  }
+}
