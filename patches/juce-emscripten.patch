diff --git a/modules/juce_core/system/juce_TargetPlatform.h b/modules/juce_core/system/juce_TargetPlatform.h
index e6e7fe1..838823b 100644
--- a/modules/juce_core/system/juce_TargetPlatform.h
+++ b/modules/juce_core/system/juce_TargetPlatform.h
@@ -77,6 +77,12 @@
   #define       JUCE_ANDROID 1
 #elif defined (__FreeBSD__) || defined (__OpenBSD__)
   #define       JUCE_BSD 1
+// Emscripten must be tested BEFORE Linux. Host projects (Surge among them)
+// commonly define LINUX as their own platform macro, which would otherwise
+// select JUCE_LINUX under emcc and pull in sys/prctl.h, sys/vfs.h and X11,
+// none of which exist in the Emscripten sysroot.
+#elif defined (__EMSCRIPTEN__) || defined (__wasm__)
+  #define       JUCE_WASM 1
 #elif defined (LINUX) || defined (__linux__)
   #define       JUCE_LINUX 1
 #elif defined (__APPLE_CPP__) || defined (__APPLE_CC__)
