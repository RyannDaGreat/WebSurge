+++ b/modules/juce_audio_processors/utilities/juce_PluginHostType.cpp
@@ -319,6 +319,9 @@ PluginHostType::HostType PluginHostType::getHostType()
 
    #elif JUCE_IOS
    #elif JUCE_ANDROID
+   #elif JUCE_WASM
+    // A browser has no host application to identify, so UnknownHost is
+    // the right answer -- same as the iOS and Android cases above.
    #else
     #error
    #endif
diff --git a/modules/juce_core/juce_core.cpp b/modules/juce_core/juce_core.cpp
index 076f283..f78009a 100644
--- a/modules/juce_core/juce_core.cpp
+++ b/modules/juce_core/juce_core.cpp
@@ -268,6 +268,28 @@
 
 //==============================================================================
 #elif JUCE_WASM
+ // Emscripten is POSIX over MEMFS, so the Linux file and thread backends
+ // apply unchanged -- the same reuse the BSD branch above relies on.
+ // Without these, File, Thread and Process have no implementation at all
+ // and the link fails on juce::File::isSymbolicLink and friends.
+ // juce_BasicNativeHeaders.h brings these in for Linux but not for wasm,
+ // and juce_CommonFile_linux.cpp needs both.
+ #include <dirent.h>
+ #include <fnmatch.h>
+ // Our own file backend, not juce_Files_linux.cpp: that one needs
+ // juce_getExecutableFile and the memory-mapping code which upstream
+ // already excludes for wasm in juce_SharedCode_posix.h. It must come
+ // FIRST: it also restores updateStatInfoForFile, which the directory
+ // iterator below calls and which lives in that same excluded block.
+ #include <surge_wasm/juce_Files_wasm.cpp>
+ // Directory iteration is plain opendir/readdir and works over MEMFS.
+ #include "native/juce_CommonFile_linux.cpp"
+ // Not juce_Network_linux.cpp: it needs ifaddrs and poll, absent from the
+ // Emscripten sysroot. A page cannot open raw sockets at all, so this
+ // supplies cleanly-failing implementations instead.
+ #include <surge_wasm/juce_Network_wasm.cpp>
+ // Threads_linux is fine as-is: Emscripten implements pthreads.
+ #include "native/juce_Threads_linux.cpp"
  #include "native/juce_SystemStats_wasm.cpp"
  #include "native/juce_PlatformTimer_generic.cpp"
 #endif
