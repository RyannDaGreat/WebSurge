diff --git a/modules/juce_events/timers/juce_Timer.cpp b/modules/juce_events/timers/juce_Timer.cpp
index ce45c31..d27d854 100644
--- a/modules/juce_events/timers/juce_Timer.cpp
+++ b/modules/juce_events/timers/juce_Timer.cpp
@@ -181,9 +181,32 @@ public:
 
     void callTimersSynchronously()
     {
+       #if JUCE_WASM
+        /*
+         * There is no timer thread here.
+         *
+         * run() is what normally charges every timer for the time that has
+         * passed, and an Emscripten build without -pthread never starts it. So
+         * callTimers() below would find countdownMs still positive on the first
+         * timer, break out of its loop immediately, and fire nothing -- not
+         * late, but never, for the lifetime of the program.
+         *
+         * Do what run() does: bill the queue for the wall-clock time since the
+         * last pump. The page's animation frame is the run loop.
+         */
+        const auto nowMs = Time::getMillisecondCounter();
+        getTimeUntilFirstTimer ((int) (nowMs >= lastSyncMs ? nowMs - lastSyncMs : 0));
+        lastSyncMs = nowMs;
+       #endif
+
         callTimers();
     }
 
+   #if JUCE_WASM
+    /* When callTimersSynchronously() last ran, to measure elapsed time against. */
+    uint32 lastSyncMs = Time::getMillisecondCounter();
+   #endif
+
     void addTimer (Timer* t)
     {
         const LockType::ScopedLockType sl (lock);
