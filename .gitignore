# Build trees and toolchains — regenerable via setup.sh / build scripts
/build/
/vendor/
/emsdk/
.claude_logs/
.claude_vlm_checks/
.frenzy/

# Surge resource data, staged by tools/stage_data.sh.
#
# The FACTORY banks are committed so the GitHub Pages deploy is self-contained:
# 639 patches (24 MB) plus factory wavetables (6.3 MB). Everything else is
# reproducible from the pinned Surge SHA and would push the repo past what is
# reasonable, so it stays out. Run tools/stage_data.sh to get the full set
# locally; the site simply lists fewer patches without it.
# Only the packed archive is deployed. The loose banks are BUILD INPUT for
# tools/pack_data.py -- committing them too would ship every factory patch
# twice, once loose and once inside the archive. The browser reads only the
# archive: Surge mounts it, and the sidebar loads patches from that same mounted
# filesystem rather than fetching files over HTTP.
/src/data/*
!/src/data/surge-data.bin
!/src/data/surge-data.json
!/src/data/surge-remote.json
# The 3rd-party bank IS committed, as loose files rather than in the archive:
# 241 MB in the startup download would be unusable, but as individual files each
# patch costs nothing until someone actually picks it.
!/src/data/patches_3rdparty/

# Emscripten build products.
#
# These ARE committed, unlike most build output: GitHub Pages serves this
# directory verbatim and cannot build wasm itself, so the deploy needs them.
# Regenerate with ./build.sh and ./build_gui.sh.
/src/js/*.wasm.map

# Dev-only browser-test tooling (puppeteer). Reinstalled by run_server.sh /
# `npm install`; package-lock.json is committed so it is reproducible.
/node_modules/

__pycache__/
*.pyc
scratchpad*
!scratchpad*.md
